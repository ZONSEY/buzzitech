# Application
NODE_ENV=development
PORT=3000
APP_NAME=Buzzitech API
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:4200

# Database
POSTGRES_DB=buzzitech
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@db:5432/buzzitech

# JWT
JWT_SECRET=replace_with_32_chars_minimum_secret_key
JWT_REFRESH_SECRET=replace_with_32_chars_minimum_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=from@example.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Upload
UPLOAD_MAX_SIZE=10485760

# Postgres creds (optional override)
POSTGRES_HOST=db
POSTGRES_PORT=5432
