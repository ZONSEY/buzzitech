generator client {
  provider = "prisma-client-js"
   output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLIENT
  TECHNICIEN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ProjectStatus {
  NEW
  ANALYSIS
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BusinessServiceStatus {
  AVAILABLE
  UNAVAILABLE
}

enum PaymentMethod {
  STRIPE
  CASH
  MOBILE_MONEY
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ContractFrequency {
  MONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
}

model User {
  id                  String      @id @default(uuid())

  nom                 String
  prenom              String

  email               String      @unique
  telephone           String?     @unique

  password            String
  hashedRefreshToken  String?

  role                UserRole    @default(CLIENT)

  emailVerified             Boolean   @default(false)
  emailVerificationToken    String?
  emailVerificationExpires  DateTime?

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  addresses           Address[]

  orders              Order[]

  projectRequests     ProjectRequest[]

  contactMessages ContactMessage[]

  notifications Notification[]

  avatar            String?

  audits              Audit[]
  cart                Cart[]
  wishlistItems       WishlistItem[]
  productReviews      ProductReview[]
  technicianInterventions Intervention[] @relation("TechnicianInterventions")
  clientInterventions     Intervention[] @relation("ClientInterventions")
  equipment               Equipment[]
  maintenanceContractsAsClient     MaintenanceContract[] @relation("MaintenanceContractClient")
  maintenanceContractsAsTechnician MaintenanceContract[] @relation("MaintenanceContractTechnician")

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([email])
}

model Equipment {
  id              String    @id @default(uuid())

  name            String

  category        String?

  brand           String?

  serialNumber    String?

  installedAt     DateTime  @default(now())

  warrantyUntil   DateTime?

  notes           String?

  clientId        String
  client          User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  addressId       String?
  address         Address? @relation(fields: [addressId], references: [id])

  interventionId  String?
  intervention    Intervention? @relation(fields: [interventionId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientId])
  @@index([interventionId])
}

model MaintenanceContract {
  id              String   @id @default(uuid())

  title           String

  description     String?

  frequency       ContractFrequency

  startDate       DateTime @default(now())

  endDate         DateTime?

  // Prochaine date à laquelle une intervention doit être générée
  // automatiquement. Avancée d'un cran (selon `frequency`) à chaque
  // génération.
  nextScheduledAt DateTime

  lastGeneratedAt DateTime?

  isActive        Boolean  @default(true)

  clientId        String
  client          User @relation("MaintenanceContractClient", fields: [clientId], references: [id], onDelete: Cascade)

  technicianId    String?
  technician      User? @relation("MaintenanceContractTechnician", fields: [technicianId], references: [id])

  addressId       String?
  address         Address? @relation(fields: [addressId], references: [id])

  interventions   Intervention[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientId])
  @@index([isActive])
  @@index([nextScheduledAt])
}

model Category {
  id          String   @id @default(uuid())

  name        String
  slug        String   @unique

  description String?

  isActive    Boolean  @default(true)

  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model Brand {
  id          String   @id @default(uuid())

  name        String
  slug        String   @unique

  logo        String?

  isActive    Boolean  @default(true)

  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
 
  @@unique([name])
  @@index([name])
  @@index([slug])
  @@index([isActive])
}

model Product {

  id            String @id @default(uuid())

  name          String

  slug          String @unique

  description   String

  sku           String? @unique

  price         Decimal @db.Decimal(10,2)

  stock         Int @default(0)

  isActive      Boolean @default(true)

  brandId       String

  categoryId    String
  

  brand         Brand @relation(fields: [brandId], references: [id])

  category      Category @relation(fields: [categoryId], references: [id])

  featured      Boolean   @default(false)

  weight        Decimal?  @db.Decimal(8,2)

  warranty      Int?      // en mois

  metaTitle     String?

  metaDescription String?

  images        ProductImage[]

  orderItems    OrderItem[]

  wishlistedBy  WishlistItem[]

  reviews       ProductReview[]

   cartItems     CartItem[]

  createdAt     DateTime @default(now())

  updatedAt     DateTime @updatedAt

  createdById String?

  updatedById String?

  @@index([featured])

  @@index([categoryId])

  @@index([brandId])

  @@index([slug])

  @@index([name])

  @@index([price])

  @@index([isActive])
}

model ProductImage {

  id String @id @default(uuid())

  url String

  alt String?

  isPrimary Boolean @default(false)

  productId String
  
  displayOrder Int @default(0)

  product Product @relation(fields:[productId], references:[id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
}

model BusinessServiceCategory {
  id          String   @id @default(uuid())

  name        String
  slug        String   @unique

  description String?

  isActive    Boolean  @default(true)

  services    BusinessService[]
  realisations Realisation[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name])

  @@index([name])
  @@index([slug])
  @@index([isActive])
}

model BusinessService {
  id                  String   @id @default(uuid())

  name                String
  slug                String   @unique

  description         String

  shortDescription    String?

  price               Decimal  @db.Decimal(10,2)

  estimatedDuration   Int? // durée en heures

  status              BusinessServiceStatus @default(AVAILABLE)

  featured            Boolean @default(false)

  image               String?

  categoryId          String

  category            BusinessServiceCategory @relation(fields: [categoryId], references: [id])

  orderItems          OrderItem[]

   cartItems           CartItem[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([featured])

  @@index([status])
  
  @@index([categoryId])
  @@index([price])
  @@index([slug])
  @@index([name])
}

model Address {
  id          String   @id @default(uuid())

  label       String // Maison, Bureau...

  recipient   String

  phone       String

  country     String

  city        String

  address     String

  postalCode  String?

  isDefault   Boolean @default(false)

  userId      String

  orders Order[]
  interventions Intervention[]
  equipment Equipment[]
  maintenanceContracts MaintenanceContract[]

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Cart {
  id          String   @id @default(uuid())

  userId      String   @unique

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items       CartItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CartItem {
  id                  String   @id @default(uuid())

  quantity            Int

  cartId              String

  productId           String?

  businessServiceId   String?

  cart                Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  product             Product? @relation(fields: [productId], references: [id])

  businessService     BusinessService? @relation(fields: [businessServiceId], references: [id])

  unitPrice Decimal @db.Decimal(10,2)

  createdAt           DateTime @default(now())

  @@unique([cartId, businessServiceId])
  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@index([businessServiceId])
}

model WishlistItem {
  id          String   @id @default(uuid())

  userId      String
  productId   String

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model ProductReview {
  id          String   @id @default(uuid())

  userId      String
  productId   String

  rating      Int
  comment     String?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}

model Order {
  id            String   @id @default(uuid())

  reference     String   @unique

  subtotal      Decimal @db.Decimal(10,2)

  shippingCost  Decimal @default(0) @db.Decimal(10,2)

  discount      Decimal @default(0) @db.Decimal(10,2)

  totalAmount   Decimal  @db.Decimal(10,2)

  notes         String?

  status        OrderStatus @default(PENDING)

  userId        String

  addressId     String?

  promoCodeId   String?

  user          User @relation(fields: [userId], references: [id])

  address Address? @relation(fields:[addressId], references:[id])

  promoCode     PromoCode? @relation(fields: [promoCodeId], references: [id])

  items         OrderItem[]

  payments      Payment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])

  @@index([reference])
  @@index([promoCodeId])
}

model PromoCode {
  id              String       @id @default(uuid())

  code            String       @unique

  description     String?

  discountType    DiscountType

  discountValue   Decimal      @db.Decimal(10,2)

  minOrderAmount  Decimal?     @db.Decimal(10,2)

  maxUses         Int?

  maxUsesPerUser  Int?         @default(1)

  isActive        Boolean      @default(true)

  startsAt        DateTime?

  expiresAt       DateTime?

  orders          Order[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([code])
  @@index([isActive])
}

model OrderItem {
  id                  String   @id @default(uuid())

  quantity            Int

  unitPrice           Decimal @db.Decimal(10,2)

  orderId             String

  productId           String?

  businessServiceId   String?

  order               Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  product             Product? @relation(fields: [productId], references: [id])

  businessService     BusinessService? @relation(fields: [businessServiceId], references: [id])

  intervention        Intervention?

  @@index([orderId])

  @@index([productId])

  @@index([businessServiceId])
}
enum PaymentGateway {
  STRIPE
  PAYDUNYA
  ORANGE_MONEY
  WAVE
}

model Payment {
  id                    String   @id @default(uuid())
  gateway PaymentGateway

  transactionId         String?  @unique

  stripeSessionId       String?  @unique

  stripePaymentIntentId String?  @unique

  amount                Decimal  @db.Decimal(10,2)

  method                PaymentMethod

  status                PaymentStatus @default(PENDING)

  paidAt                DateTime?

  failureReason         String?

  refundedAt            DateTime?

  orderId               String

  order                 Order @relation(fields: [orderId], references: [id])

  createdAt             DateTime @default(now())

  @@index([orderId])
  @@index([status])
}

model ContactMessage {
  id          String   @id @default(uuid())

  name        String

  email       String

  phone       String?

  subject     String

  message     String
  

  isRead      Boolean @default(false)
  
  answered Boolean @default(false)

  userId String?

  user User? @relation(fields:[userId], references:[id])
  createdAt   DateTime @default(now())
}

model ProjectRequest {
  id            String   @id @default(uuid())

  reference     String?

  title         String

  description   String

  budget        Decimal? @db.Decimal(10,2)

 estimatedCost Decimal? @db.Decimal(10,2)

  estimatedDuration Int?

  adminComment String?

  archived Boolean @default(false)

  // Localisation d'intervention choisie par le client sur la carte
  // (coordonnées GPS + libellé lisible, ex. issu du géocodage inverse).
  locationLat     Float?
  locationLng     Float?
  locationAddress String?

  deadline      DateTime?

  status        ProjectStatus @default(NEW)

  userId        String

  user          User @relation(fields: [userId], references: [id])

  intervention  Intervention?

  quoteItems    QuoteLineItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model QuoteLineItem {
  id               String   @id @default(uuid())

  projectRequestId String
  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)

  designation      String
  quantity         Int      @default(1)
  unitPrice        Decimal  @db.Decimal(12,2)
  displayOrder     Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([projectRequestId])
}

enum InterventionStatus {
  SCHEDULED
  ACCEPTED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Intervention {
  id                String   @id @default(uuid())

  reference         String   @unique

  title             String
  description       String?

  status            InterventionStatus @default(SCHEDULED)

  scheduledAt       DateTime
  startedAt         DateTime?
  completedAt       DateTime?

  // Durée réelle en minutes. Renseignée automatiquement à la clôture
  // (completedAt - startedAt) mais modifiable par le technicien si le
  // calcul ne reflète pas le temps réellement passé sur place.
  actualDuration    Int?

  observations      String?
  report            String?
  // Signature du client à la clôture (image encodée en base64 data URL).
  clientSignature   String?

  // Note du client sur la prestation du technicien (1 à 5), donnée une
  // fois la mission terminée.
  clientRating        Int?
  clientRatingComment String?
  ratedAt              DateTime?

  clientId          String
  client            User @relation("ClientInterventions", fields: [clientId], references: [id])

  technicianId      String?
  technician        User? @relation("TechnicianInterventions", fields: [technicianId], references: [id])

  addressId         String?
  address           Address? @relation(fields: [addressId], references: [id])
  // Copie figée de l'adresse au moment de la planification : reste
  // lisible même si le client modifie/supprime l'adresse plus tard.
  addressText        String?

  // Localisation transmise au technicien (copiée depuis la demande de
  // projet à la création, ou saisie/ajustée manuellement par l'admin).
  locationLat     Float?
  locationLng     Float?
  locationAddress String?

  orderItemId       String? @unique
  orderItem         OrderItem? @relation(fields: [orderItemId], references: [id])

  projectRequestId  String? @unique
  projectRequest    ProjectRequest? @relation(fields: [projectRequestId], references: [id])

  photos            InterventionPhoto[]
  materials         InterventionMaterial[]
  equipment         Equipment[]

  maintenanceContractId String?
  maintenanceContract   MaintenanceContract? @relation(fields: [maintenanceContractId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([technicianId])
  @@index([clientId])
  @@index([status])
  @@index([scheduledAt])
}

model InterventionPhoto {
  id              String   @id @default(uuid())

  interventionId  String
  intervention    Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  url             String

  createdAt       DateTime @default(now())

  @@index([interventionId])
}

model InterventionMaterial {
  id              String   @id @default(uuid())

  interventionId  String
  intervention    Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  name            String
  quantity        Int      @default(1)

  // Référence optionnelle vers le catalogue : si renseignée, la quantité
  // est décomptée du stock à l'ajout et recréditée à la suppression.
  materialItemId  String?
  materialItem    MaterialItem? @relation(fields: [materialItemId], references: [id])

  createdAt       DateTime @default(now())

  @@index([interventionId])
}

model MaterialItem {
  id            String   @id @default(uuid())

  name          String   @unique

  unit          String? // ex: unité, mètre, rouleau

  stockQuantity Int      @default(0)

  minStockAlert Int?

  imageUrl      String?

  isActive      Boolean  @default(true)

  interventionMaterials InterventionMaterial[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
}

model Audit {
  id          String   @id @default(uuid())

  action      String

  entity      String

  entityId    String

  details     Json?

  ipAddress   String?
  
  success     Boolean  @default(true)

  severity    AuditSeverity @default(INFO)

  userAgent   String?

  userId      String

  user        User @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
   
  @@index([action])
  @@index([entity])
  @@index([userId])
  @@index([createdAt])
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {

  id          String   @id @default(uuid())

  title       String
  message     String

  type        NotificationType @default(INFO)

  isRead      Boolean @default(false)
  readAt      DateTime?

  link        String?
  icon        String?

  metadata    Json?

  userId      String

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model Realisation {
  id                String   @id @default(uuid())

  title             String
  slug              String   @unique

  description       String
  shortDescription  String?

  clientName        String?
  location          String?

  completedAt       DateTime?

  featured          Boolean  @default(false)
  isActive          Boolean  @default(true)

  categoryId        String?
  category          BusinessServiceCategory? @relation(fields: [categoryId], references: [id])

  images            RealisationImage[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([featured])
  @@index([isActive])
  @@index([categoryId])
  @@index([slug])
}

model RealisationImage {

  id String @id @default(uuid())

  url String

  alt String?

  isPrimary Boolean @default(false)

  realisationId String

  displayOrder Int @default(0)

  realisation Realisation @relation(fields:[realisationId], references:[id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([realisationId])
}

model EmailLog {
  id          String      @id @default(uuid())
  to          String
  subject     String
  template    String
  status      EmailStatus @default(PENDING)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime    @default(now())
}